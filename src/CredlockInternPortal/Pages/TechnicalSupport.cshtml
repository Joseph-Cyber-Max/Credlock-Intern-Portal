@page
@using CredlockInternPortal.Data
@using Microsoft.EntityFrameworkCore
@inject PortalDbContext Db
@{ ViewData["Title"] = "Technical Support Lab"; var tickets = await Db.SupportTickets.OrderByDescending(x => x.CreatedAt).Take(50).ToListAsync(); }
<div class="dashboard-body standalone-page"><div class="page-header"><span class="eyebrow">SMARTPHONE BNPL SUPPORT LAB</span><h1>Technical Support</h1><p>Practice authorized diagnosis, evidence collection, documentation and engineering escalation.</p></div><div class="dashboard-card"><div class="lab-grid"><div><h3>Support workflow</h3><p>Customer verification → Device identification → Enrollment → Authentication → Connectivity → Synchronization → Application → System status → Evidence → Resolution/Escalation.</p></div><div><h3>Scenario categories</h3><p>Device lock/unlock, app installation/removal, enrollment failure, authentication, synchronization, network, Android, payment/device status, merchant and API/application errors.</p></div></div></div><section class="dashboard-card"><h3>Recent support tickets</h3><div class="table-scroll"><table><thead><tr><th>Subject</th><th>Category</th><th>Priority</th><th>Status</th></tr></thead><tbody>@foreach (var t in tickets) { <tr><td>@t.Subject</td><td>@t.Category</td><td>@t.Priority</td><td>@t.Status</td></tr> } @if (!tickets.Any()) { <tr><td colspan="4">No support tickets recorded yet.</td></tr> }</tbody></table></div></section><a class="back-link" href="/Dashboard">← Back to dashboard</a></div>
