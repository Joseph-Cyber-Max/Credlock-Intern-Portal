@page
@model CredlockInternPortal.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="dashboard-body">
    <section class="dashboard-hero"><div><span class="eyebrow">INTERNSHIP OPERATIONS</span><h2>Everything you need to keep the programme moving.</h2><p>Monitor intern activity, learning, attendance and performance from a single workspace.</p></div><div class="hero-orb"><span>12</span><small>week programme</small></div></section>
    <section class="dashboard-stats">
        <article class="dash-stat"><div class="stat-icon">◉</div><span>Active interns</span><strong>@Model.ActiveInterns</strong><small>Live database count</small></article>
        <article class="dash-stat"><div class="stat-icon">◷</div><span>Attendance</span><strong>@Model.AttendanceRate%</strong><small>Recorded attendance</small></article>
        <article class="dash-stat"><div class="stat-icon">✓</div><span>Learning progress</span><strong>@Model.LearningProgress%</strong><small>@Model.CompletedLessons of @Model.TotalLessons lessons</small></article>
        <article class="dash-stat"><div class="stat-icon">↗</div><span>Projects</span><strong>@Model.ProjectCount</strong><small>Programme projects</small></article>
    </section>
    <div class="content-grid">
        <section class="dashboard-card progress-card"><div class="card-heading"><div><span class="eyebrow">PROGRAMME HEALTH</span><h3>Learning progress</h3></div><a href="/Reports">View reports →</a></div><div class="progress-row"><div><span>Learning activities</span><strong>@Model.LearningProgress%</strong></div><div class="progress-track"><span style="width:@Model.LearningProgress%"></span></div></div><div class="progress-row"><div><span>Attendance</span><strong>@Model.AttendanceRate%</strong></div><div class="progress-track"><span style="width:@Model.AttendanceRate%"></span></div></div></section>
        <section class="dashboard-card quick-card"><div class="card-heading"><div><span class="eyebrow">QUICK ACTIONS</span><h3>Get things done</h3></div></div><div class="quick-grid"><a href="/Interns"><b>+</b><span>Add / manage intern</span></a><a href="/Attendance"><b>◷</b><span>Record attendance</span></a><a href="/Tasks"><b>✓</b><span>Manage tasks</span></a><a href="/Reports"><b>▤</b><span>Generate report</span></a></div></section>
    </div>
    <section class="dashboard-card modules-card"><div class="card-heading"><div><span class="eyebrow">PORTAL MODULES</span><h3>Manage the internship lifecycle</h3></div></div><div class="module-grid"><a href="/Interns"><b>01</b><div><strong>Intern Management</strong><p>Profiles, placements and supervisors</p></div><span>→</span></a><a href="/Attendance"><b>02</b><div><strong>Attendance</strong><p>Check-ins, absences and history</p></div><span>→</span></a><a href="/Learning"><b>03</b><div><strong>Learning Plan</strong><p>12 weeks, lessons and milestones</p></div><span>→</span></a><a href="/TechnicalSupport"><b>04</b><div><strong>Support &amp; Cybersecurity</strong><p>BNPL troubleshooting and secure support</p></div><span>→</span></a></div></section>
</div>
