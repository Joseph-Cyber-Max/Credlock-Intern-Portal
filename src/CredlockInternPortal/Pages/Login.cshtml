@page
@model CredlockInternPortal.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "~/Pages/Shared/_LoginLayout.cshtml";
}
<div class="auth-shell">
    <div class="auth-card">
        <div class="brand-mark">C</div>
        <h1>Credlock Intern Portal</h1>
        <p class="muted">Sign in to manage your internship journey.</p>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
            <span asp-validation-for="Email" class="validation"></span>
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required />
            <span asp-validation-for="Password" class="validation"></span>
            <button class="primary" type="submit">Sign in</button>
        </form>
        <small>Development account: admin@credlock.africa / Admin@123</small>
    </div>
</div>
