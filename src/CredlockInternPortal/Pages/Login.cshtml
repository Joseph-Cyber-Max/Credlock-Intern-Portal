@page
@model CredlockInternPortal.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "~/Pages/Shared/_LoginLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-visual">
        <a class="auth-brand" href="/Login">
            <span class="brand-mark">C</span>
            <span><strong>Credlock</strong><small>Intern Portal</small></span>
        </a>
        <div class="visual-content">
            <span class="eyebrow">SIWES • INTERNSHIP MANAGEMENT</span>
            <h1>Build skills.<br /><span>Track progress.</span><br />Grow with purpose.</h1>
            <p>A modern workspace for interns, supervisors and HR to manage every stage of the internship journey.</p>
            <div class="visual-points">
                <div><b>01</b><span>Attendance & activity tracking</span></div>
                <div><b>02</b><span>12-week learning progress</span></div>
                <div><b>03</b><span>Tasks, assessments & reports</span></div>
            </div>
        </div>
        <div class="visual-footer">© 2026 Credlock Africa</div>
    </div>

    <main class="auth-panel">
        <div class="auth-card">
            <div class="mobile-brand"><span class="brand-mark">C</span><strong>Credlock</strong></div>
            <div class="auth-heading">
                <span class="eyebrow">WELCOME BACK</span>
                <h2>Sign in to your portal</h2>
                <p>Enter your credentials to continue.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert" role="alert"><span>!</span><div>@Model.ErrorMessage</div></div>
            }

            <form method="post" class="auth-form">
                <div class="field">
                    <label asp-for="Email">Email address</label>
                    <div class="input-wrap"><span class="input-icon">@@</span><input asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com" required autofocus /></div>
                    <span asp-validation-for="Email" class="validation"></span>
                </div>
                <div class="field">
                    <div class="label-row"><label asp-for="Password">Password</label><a href="#">Forgot password?</a></div>
                    <div class="input-wrap"><span class="input-icon">••</span><input asp-for="Password" id="password" type="password" autocomplete="current-password" placeholder="Enter your password" required /><button class="password-toggle" type="button" onclick="togglePassword()" aria-label="Show password">Show</button></div>
                    <span asp-validation-for="Password" class="validation"></span>
                </div>
                <label class="remember"><input type="checkbox" /> <span>Keep me signed in</span></label>
                <button class="primary auth-submit" type="submit"><span>Sign in</span><span>→</span></button>
            </form>

            <div class="secure-note"><span>✓</span> Secure session protected by the portal</div>
        </div>
    </main>
</div>

@section Scripts {
<script>
function togglePassword() {
    const input = document.getElementById('password');
    const button = document.querySelector('.password-toggle');
    if (input.type === 'password') { input.type = 'text'; button.textContent = 'Hide'; }
    else { input.type = 'password'; button.textContent = 'Show'; }
}
</script>
}
