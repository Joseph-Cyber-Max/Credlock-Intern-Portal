@page
@model CredlockInternPortal.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="hero">
    <div>
        <span class="eyebrow">CREDLOCK • SIWES / INTERN MANAGEMENT</span>
        <h1>Manage interns from onboarding to completion.</h1>
        <p class="hero-copy">A centralized workspace for HR, supervisors, and interns to track learning plans, attendance, tasks, assessments, and progress.</p>
        <div class="hero-actions">
            <a class="button primary" href="#features">Explore Portal</a>
            <a class="button secondary" href="#quick-start">Quick Start</a>
        </div>
    </div>
    <div class="hero-card">
        <div class="metric-label">Portal status</div>
        <div class="metric-value">Ready</div>
        <div class="metric-note">Foundation deployed • ASP.NET Core</div>
        <div class="status-pill"><span class="status-dot"></span> System online</div>
    </div>
</section>

<section class="stats-grid" id="quick-start">
    <article class="stat-card"><span>01</span><strong>Onboarding</strong><p>Register interns and assign departments and supervisors.</p></article>
    <article class="stat-card"><span>02</span><strong>Learning</strong><p>Manage 12-week tracks, courses, activities, and milestones.</p></article>
    <article class="stat-card"><span>03</span><strong>Tracking</strong><p>Capture attendance, tasks, progress, and supervisor reviews.</p></article>
    <article class="stat-card"><span>04</span><strong>Reporting</strong><p>Prepare HR-ready summaries, performance reports, and completion records.</p></article>
</section>

<section class="feature-section" id="features">
    <div class="section-heading">
        <span class="eyebrow">CORE MODULES</span>
        <h2>Everything in one portal</h2>
    </div>
    <div class="feature-grid">
        <article class="feature-card"><h3>Secure Access</h3><p>Role-aware access for administrators, HR, supervisors, and interns.</p></article>
        <article class="feature-card"><h3>Intern Profiles</h3><p>Central profile, placement, department, supervisor, and onboarding information.</p></article>
        <article class="feature-card"><h3>Learning Plans</h3><p>Course tracks, weekly objectives, practical activities, and learning milestones.</p></article>
        <article class="feature-card"><h3>Attendance</h3><p>Daily attendance and activity logging with supervisor visibility.</p></article>
        <article class="feature-card"><h3>Tasks & Assessments</h3><p>Assignments, submissions, evaluations, scores, and feedback.</p></article>
        <article class="feature-card"><h3>Dashboards & Reports</h3><p>Operational dashboards and export-ready HR reporting views.</p></article>
    </div>
</section>
