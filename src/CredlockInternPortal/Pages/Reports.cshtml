@page
@using CredlockInternPortal.Data
@using Microsoft.EntityFrameworkCore
@inject PortalDbContext Db
@{ ViewData["Title"] = "Reports"; var interns = await Db.InternProfiles.CountAsync(x => x.IsActive); var attendance = await Db.Attendance.CountAsync(); var lessons = await Db.Lessons.CountAsync(); var completed = await Db.LearningProgress.CountAsync(x => x.Completed); var tickets = await Db.SupportTickets.CountAsync(); var escalations = await Db.EngineeringEscalations.CountAsync(); }
<div class="dashboard-body standalone-page"><div class="page-header"><span class="eyebrow">REPORTING & ANALYTICS</span><h1>Programme Reports</h1><p>Live operational indicators from the portal database.</p></div><div class="dashboard-stats"><article class="dash-stat"><span>Active interns</span><strong>@interns</strong></article><article class="dash-stat"><span>Attendance records</span><strong>@attendance</strong></article><article class="dash-stat"><span>Lessons completed</span><strong>@completed / @lessons</strong></article><article class="dash-stat"><span>Support escalations</span><strong>@escalations</strong></article></div><section class="dashboard-card"><h3>Operational data</h3><p>@tickets support tickets are currently stored. Use the management modules to build attendance, learning, task, assessment and escalation reports as records are added.</p></section><a class="back-link" href="/Dashboard">← Back to dashboard</a></div>
